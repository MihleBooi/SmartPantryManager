
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFF0F5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="♡ Settings ♡"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#8E3B62"
        android:gravity="center"
        android:padding="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage your pantry preferences."
        android:textSize="16sp"
        android:textColor="#000000"
        android:layout_marginBottom="20dp" />

    <Switch
        android:id="@+id/switchExpiryNotifications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Expiry Notifications"
        android:textSize="18sp"
        android:textColor="#8E3B62"
        android:padding="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Receive reminders when ingredients are close to their expiry dates."
        android:textSize="14sp"
        android:textColor="#000000"
        android:padding="12dp" />

</LinearLayout>
