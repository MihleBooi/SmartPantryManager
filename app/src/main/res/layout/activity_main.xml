
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFF0F5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="♡ My Pantry ♡"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:gravity="center"
        android:padding="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Keep track of your ingredients!"
        android:textSize="16sp"
        android:textColor="#000000"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnOpenPantry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open My Pantry"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FF4081" />

    <TextView
        android:id="@+id/txtEmptyPantry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your pantry is empty.\nAdd your first ingredient! 🌷"
        android:textSize="18sp"
        android:textColor="#000000"
        android:gravity="center"
        android:layout_marginTop="40dp" />

</LinearLayout>
