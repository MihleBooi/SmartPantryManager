
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFF0F5">

    <TextView
        android:id="@+id/txtRecipeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Suggested Recipes"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#8E3B62"
        android:gravity="center"
        android:padding="12dp" />

    <TextView
        android:id="@+id/txtRecipeInstructions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recipes you can make with ingredients in your pantry:"
        android:textSize="16sp"
        android:textColor="#000000"
        android:padding="8dp" />

    <ListView
        android:id="@+id/listRecipes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:dividerHeight="8dp" />

</LinearLayout>
